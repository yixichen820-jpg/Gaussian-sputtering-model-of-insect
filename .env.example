PORT=4173

# 本项目会从项目根目录的 .env 读取配置，该文件已被 Git 忽略。
# 通过系统环境变量提供的值优先于 .env 中的同名值。
# 必填。请填写独立生成的长随机密钥，不要复用公开或示例值。
# 留空或未设置时，服务器会拒绝启动。
ADMIN_KEY=

# 阿里云 OSS，按需填写。三项 AccessKey/Bucket/Region 都填了才启用 OSS，
# 否则上传的 PLY 会保存在 ECS 本地 models/ 目录。
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_PREFIX=models
# 通常可省略，服务端会按 bucket.region 自动生成。
# 如果要手动指定，就把下面的 your-bucket-name 改成真实 Bucket 名称。
# OSS_BASE_URL=https://your-bucket-name.oss-cn-hangzhou.aliyuncs.com
